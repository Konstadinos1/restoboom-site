# RestoBoom marketing site — placeholders only. Copy to .env.local and fill in.
# Every NEXT_PUBLIC_* value is baked into the static build and visible to visitors:
# never put a secret here. In CI, set these as repo *Variables* (not Secrets) for deploy.yml.

# Canonical site URL (canonical, sitemap, OG, JSON-LD). Test site:
NEXT_PUBLIC_SITE_URL=https://konstadinos1.github.io/restoboom-site
NEXT_PUBLIC_CONTACT_EMAIL=bonjour@restoboom.ca

# --- Lead capture (pick one; the form falls back to a mailto link if neither is set) ---
# Preferred: the diagnostic-lead Supabase Edge Function (validation, rate limit, webhook).
NEXT_PUBLIC_LEAD_ENDPOINT=https://YOUR-PROJECT.supabase.co/functions/v1/diagnostic-lead
# Legacy: direct insert with the anon key into the insert-only RLS table.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Analytics (optional, consent-gated, cookieless) ---
# Plausible-compatible /api/event endpoint. Self-host in Canada to keep the
# "data in Canada" promise. Leave empty to ship with no analytics and no consent banner.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
NEXT_PUBLIC_ANALYTICS_DOMAIN=restoboom.ca

# --- Edge Function secrets (set with `supabase secrets set`, NEVER in this file's NEXT_PUBLIC_ vars) ---
# ALLOWED_ORIGINS=https://konstadinos1.github.io
# IP_HASH_SALT=<random string>
# LEAD_WEBHOOK_URL=<optional: n8n / Slack / outreach pipeline webhook>
