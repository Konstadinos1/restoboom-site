# RestoBoom marketing site — placeholders only. Copy to .env.local and fill in.
# Never commit real keys.

# Canonical site URL (used for sitemap/canonical). Test site:
NEXT_PUBLIC_SITE_URL=https://konstadinos1.github.io/restoboom-site

# Supabase project that stores diagnostic leads (hosted project, NOT localhost).
# Create a free project at supabase.com, run supabase/schema.sql in its SQL editor,
# then paste the project URL and the anon (publishable) key here.
# The anon key is public-by-design; the table is insert-only via RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Shown on the site as the contact address if the form is not configured yet.
NEXT_PUBLIC_CONTACT_EMAIL=bonjour@restoboom.ca
